<Window x:Class="Webesshop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Webesshop"
        mc:Ignorable="d"
        Title="Webesshop" Height="450" Width="800"
        WindowState="Maximized">
    <Window.Resources>
        <ResourceDictionary Source="Resources/Dictionary1.xaml" />
    </Window.Resources>

    <DockPanel Background="GreenYellow">
        <StackPanel DockPanel.Dock="Top" Height="70" Background="DarkKhaki" Orientation="Horizontal" HorizontalAlignment="Center">
                <Button
                    x:Name="ertekessegekmenu"
                    Content="Értékességek"
                    Click="ertekessegekmenu_Click"
                    Style="{StaticResource ResourceKey=listitemstyle}" />
                <Button
                    x:Name="felhasznalokmenu"
                    Content="Felhasznalok"
                    Click="felhasznalokmenu_Click"
                    Style="{StaticResource ResourceKey=listitemstyle}" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Left">
            <TextBlock Width="70" FontSize="60" Foreground="Fuchsia" FontWeight="ExtraBlack" TextAlignment="Center" Background="Black">
                W<LineBreak/>
                E<LineBreak/>
                B<LineBreak/>
                E<LineBreak/>
                S<LineBreak/>
                S<LineBreak/>
                H<LineBreak/>
                O<LineBreak/>
                P<LineBreak/>
            </TextBlock>
        </StackPanel>
        <StackPanel x:Name="feladatpanel" DockPanel.Dock="Right" />
    </DockPanel>
</Window>
