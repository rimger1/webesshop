<UserControl x:Class="Webesshop.UserControls.UserControlTermekek"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Webesshop.UserControls">
    <StackPanel>
        <DataGrid
            x:Name="datagridtermekek"
            Width="1100"
            Height="600"
            AutoGenerateColumns="False"
            CanUserAddRows="False"
            CanUserDeleteRows="False"
            IsReadOnly="True"
            SelectionChanged="datagridtermekek_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding Id}" Header="ID" />
                <DataGridTextColumn Binding="{Binding Nev}" Header="Név" />
                <DataGridTextColumn Binding="{Binding Ar}" Header="Ár" />
                <DataGridTextColumn Binding="{Binding Kategoria}" Header="Kategória" />
            </DataGrid.Columns>
        </DataGrid>

        <WrapPanel Margin="730,10,130,0">
            
            <StackPanel Width="300" Background="LightGray">
                <TextBlock>Név:</TextBlock>
                <TextBox x:Name="nevTxt" />
                <TextBlock>Ár:</TextBlock>
                <TextBox x:Name="arTxt" />
                <TextBlock>Kategoria</TextBlock>
                <TextBox x:Name="kategoriaTxt" />
            </StackPanel>
            
            <StackPanel>
                <Button
                    x:Name="mentesBtnter"
                    Width="200"
                    Background="Green"
                    Click="mentesBtnter_Click"
                    Content="Mentés"
                    Foreground="White"
                    Visibility="Visible" />
                <Button
                    x:Name="torlesBtnter"
                    Width="200"
                    Background="red"
                    Click="torlesBtnter_Click"
                    Content="Törlés"
                    Foreground="White"
                    Visibility="Hidden" />
                <Button
                    x:Name="modBtnter"
                    Width="200"
                    Background="Yellow"
                    Click="modBtnter_Click"
                    Content="Módosítás"
                    Foreground="White"
                    Visibility="Hidden" />
            </StackPanel>
        </WrapPanel>
    </StackPanel>
</UserControl>
